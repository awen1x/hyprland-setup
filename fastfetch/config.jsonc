{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "~/.config/fastfetch/arch_minimal.txt",
        "padding": {
            "top": 1
        }
    },
    "display": {
        "separator": " ›  "
    },
    "modules": [
        "break",
        {
            "type": "os",
            "key": "OS  ",
            "keyColor": "31"
        },
        {
            "type": "disk",
            "key": "HOME",
            "folders": "/home",
            "keyColor": "blue"
        },
        {
            "type": "packages",
            "format": "{} (pacman)",
            "key": "PKG ",
            "keyColor": "33"
        },
        {
            "type": "shell",
            "key": "SH  ",
            "keyColor": "34"
        },
        {
            "type": "memory",
            "key": "RAM ",
            "keyColor": "35",
            "format": "{used} / {total} ({percentage})"
        },
        {
            "type": "wm",
            "key": "WM  ",
            "keyColor": "36"
        },
        "break",
        {
            "type": "colors",
            "symbol": "circle"
        }
    ]
}