{
    "position": "top",
    "modules-left": [
        "custom/rofi",
        "hyprland/workspaces"
        //"custom/media"
    ],
    "modules-center": [
        "clock",
        "custom/swaync"
    ],
    "modules-right": [
        "tray",
        "custom/updates",
        "pulseaudio",
        "network",
        "battery"
    ],
    "tray": {
        "icon-size": 16,
        "spacing": 7
    },
    "clock": {
        "format": "󰥔 {0:%H:%M}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "format-alt": " {:%Y-%m-%d}"
    },
    "battery": {
        "states": {
            "warning": 20,
            "critical": 15
        },
        "format": "{capacity}% {icon}",
        "format-full": "{capacity}% {icon}",
        "format-charging": "{capacity}% {icon} ",
        "format-plugged": "{capacity}% ",
        "format-alt": "{time} {icon}",
        "format-icons": [
            "",
            "",
            "",
            "",
            ""
        ]
    },
    "network": {
        "format-wifi": " {essid}",
        "format-ethernet": "{ipaddr}/{cidr} ",
        //"tooltip-format": "{essid}",
        "tooltip-format": " {none} ",
        "format-linked": "{ifname} (No IP) ",
        "format-disconnected": "Disconnected ⚠"
    },
    "pulseaudio": {
        "format": "{volume}% {icon}",
        "format-bluetooth": "{volume}% {icon}",
        "format-muted": "",
        "tooltip-format": " {none}",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": [
                "",
                "",
                ""
            ]
        },
        "scroll-step": 1
    },
    "custom/media": {
        "return-type": "json",
        "exec": "~/.config/scripts/media",
        "on-click": "playerctl play-pause"
    },
    "custom/rofi": {
        "format": "",
        "on-click": "rofi -show drun -show-icons",
        "tooltip": false
    },
    "hyprland/workspaces": {
        "on-scroll-up": "hyprctl dispatch workspace r-1",
        "on-scroll-down": "hyprctl dispatch workspace r+1",
        "on-click": "activate",
        "active-only": false,
        "all-outputs": true,
        "format": "{}",
        "format-icons": {
            "urgent": "",
            "active": "",
            "default": ""
        },
        "persistent-workspaces": {
            "*": 4
        }
    },
    "custom/swaync": {
        "tooltip": false,
        "format": "{icon}",
        "format-icons": {
            "notification": "󱅫", // Bell with notifications
            "none": "󰂚", // No notifications
            "dnd-notification": "󰂛", // DND with notifications
            "dnd-none": "󰂛", // DND no notifications
            "inhibited-notification": "",
            "inhibited-none": "",
            "dnd-inhibited-notification": "",
            "dnd-inhibited-none": ""
        },
        "return-type": "json",
        "exec-if": "which swaync-client",
        "exec": "swaync-client -swb",
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw",
        "escape": true
    },
    "custom/updates": {
        "format": "{icon} {0} ",
        "return-type": "json",
        "format-icons": {
            "has-updates": "󰞑",
            "updated": "󰞑"
        },
        "exec-if": "which waybar-module-pacman-updates",
        "exec": "waybar-module-pacman-updates --interval-seconds 3600 --network-interval-seconds 3600"
    }
}