#!/usr/bin/env bash

WALL_DIR="$HOME/Pictures/wallpapers"
LAST_FILE="/.cache/.last_wall"
WAYBAR_CSS="$HOME/.cache/wal/colors-rgba.css"

# --- Collect wallpapers ---
mapfile -t WALLS < <(find "$WALL_DIR" -type f \( -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' \))
COUNT=${#WALLS[@]}
[ "$COUNT" -eq 0 ] && exit 1

# --- Load last wallpaper ---
LAST=""
[ -f "$LAST_FILE" ] && LAST=$(cat "$LAST_FILE")

# --- Pick random non-repeating ---
while true; do
    NEXT="${WALLS[RANDOM % COUNT]}"
    [[ "$NEXT" != "$LAST" ]] && break
done
echo "$NEXT" > "$LAST_FILE"
ln -sf "$NEXT" ~/.cache/current_wallpaper

awww img "$NEXT" --transition-type any --transition-fps 60 --transition-duration 1

wal -q -i "$NEXT"

pywalfox update

pkill waybar
sleep 1
waybar &

pkill -USR1 kitty 2>/dev/null

swaync-client -rs

notify-send "Wallpaper Changed" "$NEXT" -i "$NEXT"